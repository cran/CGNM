Package: CGNM
Type: Package
Title: Cluster Gauss-Newton Method
Version: 0.10.0
Author: Yasunori Aoki [aut, cre]
Authors@R: person(given = "Yasunori",
                    family = "Aoki",
                    role = c("aut", "cre"),
